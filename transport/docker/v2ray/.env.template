# V2Ray/Xray Configuration Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env with real secrets to version control!

# V2Ray Inbound Settings
V2RAY_UUID=your-uuid-here
V2RAY_EMAIL=your-email@domain.com

# REALITY Settings
REALITY_DEST=www.cloudflare.com:443
REALITY_SERVER_NAME=www.cloudflare.com
REALITY_PRIVATE_KEY=your-reality-private-key
REALITY_SHORT_ID=your-short-id

# Trojan Outbound Servers (VPN2 layer)
TROJAN_SERVER_1=your-trojan-server-1.com
TROJAN_SERVER_2=your-trojan-server-2.com
TROJAN_SERVER_3=your-trojan-server-3.com
TROJAN_PASSWORD=your-trojan-password
TROJAN_WS_PATH=/your-ws-path
TROJAN_SERVER_NAME=your-trojan-sni.com

# Tor Settings
TOR_SOCKS_PORT=9050
TOR_CONTROL_PORT=9051

# SMP/XFTP Onion Addresses (for SimpleX over Tor)
SMP_ONION_ADDRESS=smp://your-pubkey@your-onion.onion:5223
XFTP_ONION_ADDRESS=xftp://your-pubkey@your-onion.onion:443